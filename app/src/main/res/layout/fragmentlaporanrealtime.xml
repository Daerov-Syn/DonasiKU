<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FF"
    android:orientation="vertical">

    <!-- HEADER GRADASI UNGU -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradasi_ungu"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="50dp"
        android:paddingBottom="24dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#9C27B0" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Laporan Real-Time"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terakhir diperbarui: 1 hari yang lalu"
                android:textColor="#EEEEEE"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 4 KARTU STATISTIK (GRID 2x2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Kartu 1: Total Dana -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💸" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 300rb" android:textColor="#9C27B0" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Dana" android:textColor="#888888" android:textSize="11sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▲ 18%" android:textColor="#4CAF50" android:textSize="10sp" android:textStyle="bold" android:background="#E8F5E9" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Kartu 2: Donasi Barang -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📦" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5 Paket" android:textColor="#2196F3" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Donasi Barang" android:textColor="#888888" android:textSize="11sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▲ +2 hari ini" android:textColor="#4CAF50" android:textSize="10sp" android:textStyle="bold" android:background="#E8F5E9" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Kartu 3: Jiwa Terbantu -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👨‍👩‍👧‍👦" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="40" android:textColor="#4CAF50" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jiwa Terbantu" android:textColor="#888888" android:textSize="11sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▲ 3,2%" android:textColor="#4CAF50" android:textSize="10sp" android:textStyle="bold" android:background="#E8F5E9" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Kartu 4: Akurasi Distribusi -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="98,2%" android:textColor="#FF9800" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Akurasi Distribusi" android:textColor="#888888" android:textSize="11sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▲ 0,4%" android:textColor="#4CAF50" android:textSize="10sp" android:textStyle="bold" android:background="#E8F5E9" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- GRAFIK DONASI MASUK (MOCK BAR CHART) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Donasi Masuk" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" android:layout_centerVertical="true"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mingguan" android:textColor="#9C27B0" android:textSize="10sp" android:background="#F3E5F5" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:layout_alignParentEnd="true"/>
                    </RelativeLayout>

                    <!-- Grafik Batang menggunakan CardView -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="100dp" android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="bottom" android:weightSum="7">

                        <!-- Batang Senin -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <com.google.android.material.card.MaterialCardView android:layout_width="32dp" android:layout_height="60dp" app:cardBackgroundColor="#9C27B0" app:cardCornerRadius="4dp" app:cardElevation="0dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sen" android:textSize="10sp" android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Batang Selasa -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <com.google.android.material.card.MaterialCardView android:layout_width="32dp" android:layout_height="40dp" app:cardBackgroundColor="#9C27B0" app:cardCornerRadius="4dp" app:cardElevation="0dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sel" android:textSize="10sp" android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Batang Rabu -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <com.google.android.material.card.MaterialCardView android:layout_width="32dp" android:layout_height="80dp" app:cardBackgroundColor="#9C27B0" app:cardCornerRadius="4dp" app:cardElevation="0dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rab" android:textSize="10sp" android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Batang Kamis -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <com.google.android.material.card.MaterialCardView android:layout_width="32dp" android:layout_height="50dp" app:cardBackgroundColor="#9C27B0" app:cardCornerRadius="4dp" app:cardElevation="0dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kam" android:textSize="10sp" android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Batang Jumat -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <com.google.android.material.card.MaterialCardView android:layout_width="32dp" android:layout_height="75dp" app:cardBackgroundColor="#9C27B0" app:cardCornerRadius="4dp" app:cardElevation="0dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jum" android:textSize="10sp" android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Batang Sabtu -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <com.google.android.material.card.MaterialCardView android:layout_width="32dp" android:layout_height="65dp" app:cardBackgroundColor="#9C27B0" app:cardCornerRadius="4dp" app:cardElevation="0dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sab" android:textSize="10sp" android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Batang Minggu -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <com.google.android.material.card.MaterialCardView android:layout_width="32dp" android:layout_height="30dp" app:cardBackgroundColor="#9C27B0" app:cardCornerRadius="4dp" app:cardElevation="0dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Min" android:textSize="10sp" android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SEBARAN KATEGORI (DONUT CHART) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sebaran Kategori" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="16dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

                        <!-- Mockup Donut Chart menggunakan CircularProgressIndicator -->
                        <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:progress="60"
                                app:indicatorColor="#9C27B0"
                                app:trackColor="#2196F3"
                                app:indicatorSize="80dp"
                                app:trackThickness="16dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2 kat"
                                android:textSize="12sp"
                                android:textColor="#888888"
                                android:textStyle="bold"
                                android:layout_centerInParent="true"/>
                        </RelativeLayout>

                        <!-- Legend -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:orientation="vertical">
                            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Donasi Barang" android:textColor="#666666" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60%" android:textColor="#9C27B0" android:textSize="12sp" android:textStyle="bold" android:layout_alignParentEnd="true"/>
                            </RelativeLayout>
                            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Donasi Uang" android:textColor="#666666" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="40%" android:textColor="#2196F3" android:textSize="12sp" android:textStyle="bold" android:layout_alignParentEnd="true"/>
                            </RelativeLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KOSONGKAN RUANG BAWAH AGAR BISA DI-SCROLL -->
            <View android:layout_width="match_parent" android:layout_height="40dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>