<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FF"
    tools:ignore="HardcodedText,ContentDescription">

    <!-- Header & Search -->
    <LinearLayout
        android:id="@+id/header_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradasi_ungu"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="40dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/btn_back" android:layout_width="32dp" android:layout_height="32dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_menu_revert" app:tint="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Daftar Donatur" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginStart="48dp" android:text="Dana Sembako Pra-Sejahtera - 10 donatur - Rp 8.6jt" android:textColor="#EEEEEE" android:textSize="12sp" />

        <EditText
            android:id="@+id/et_search_donatur"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_outline_gray"
            android:backgroundTint="#40FFFFFF"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="12dp"
            android:hint="Cari donatur..."
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#DDDDDD"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_section">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

            <!-- Filter Urutkan -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:layout_marginBottom="24dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Urutkan:" android:textColor="#888888" android:textSize="13sp" android:layout_marginEnd="12dp"/>
                <TextView android:id="@+id/btn_sort_terbaru" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_card_white" android:backgroundTint="#9C27B0" android:paddingHorizontal="16dp" android:paddingVertical="6dp" android:text="Terbaru" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/btn_sort_terbesar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_card_white" android:backgroundTint="#FFFFFF" android:paddingHorizontal="16dp" android:paddingVertical="6dp" android:text="Terbesar" android:textColor="#9C27B0" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TOP DONATUR 🏆" android:textColor="#9C27B0" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>

            <!-- Top 3 Cards (Disusun Statis untuk wadah dinamis di Java) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="24dp">

                <!-- Juara 1 -->
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:strokeColor="#FFC107" app:strokeWidth="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🥇" android:textSize="16sp" android:layout_marginBottom="8dp"/>
                        <androidx.cardview.widget.CardView android:layout_width="48dp" android:layout_height="48dp" app:cardBackgroundColor="#673AB7" app:cardCornerRadius="24dp" app:cardElevation="0dp">
                            <TextView android:id="@+id/tv_top1_inisial" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="BS" android:textColor="#FFFFFF" android:textStyle="bold"/>
                        </androidx.cardview.widget.CardView>
                        <TextView android:id="@+id/tv_top1_nama" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Budi" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
                        <TextView android:id="@+id/tv_top1_nominal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 2.0jt" android:textColor="#4CAF50" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ucapkan 👋" android:textColor="#FFC107" android:textSize="10sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Juara 2 -->
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_marginStart="4dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🥈" android:textSize="16sp" android:layout_marginBottom="8dp"/>
                        <androidx.cardview.widget.CardView android:layout_width="48dp" android:layout_height="48dp" app:cardBackgroundColor="#E040FB" app:cardCornerRadius="24dp" app:cardElevation="0dp">
                            <TextView android:id="@+id/tv_top2_inisial" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="KR" android:textColor="#FFFFFF" android:textStyle="bold"/>
                        </androidx.cardview.widget.CardView>
                        <TextView android:id="@+id/tv_top2_nama" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ryul" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" android:maxLines="1"/>
                        <TextView android:id="@+id/tv_top2_nominal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 2.0jt" android:textColor="#4CAF50" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ucapkan 👋" android:textColor="#4CAF50" android:textSize="10sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Juara 3 -->
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🥉" android:textSize="16sp" android:layout_marginBottom="8dp"/>
                        <androidx.cardview.widget.CardView android:layout_width="48dp" android:layout_height="48dp" app:cardBackgroundColor="#03A9F4" app:cardCornerRadius="24dp" app:cardElevation="0dp">
                            <TextView android:id="@+id/tv_top3_inisial" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="AF" android:textColor="#FFFFFF" android:textStyle="bold"/>
                        </androidx.cardview.widget.CardView>
                        <TextView android:id="@+id/tv_top3_nama" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ahmad" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" android:maxLines="1"/>
                        <TextView android:id="@+id/tv_top3_nominal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 1.5jt" android:textColor="#4CAF50" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ucapkan 👋" android:textColor="#4CAF50" android:textSize="10sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Semua Donatur (247)" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>

            <!-- Daftar List (Pagination/Sorting) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_semua_donatur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_notifikasi" />
            <!-- Nanti ganti tools:listitem dengan layout item donatur Anda -->

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>