<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProgramImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/group_2"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

            <!-- Category Badge -->
            <TextView
                android:id="@+id/tvCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/bg_tag_purple_light"
                android:backgroundTint="#80FFFFFF"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Sosial &amp; Kemanusiaan"
                android:textColor="@color/primary_purple"
                android:textSize="10sp"
                android:textStyle="bold"
                android:drawableStart="@android:drawable/ic_menu_myplaces"
                android:drawablePadding="4dp"
                app:drawableTint="@color/primary_purple" />

            <!-- Days Badge -->
            <TextView
                android:id="@+id/tvDaysBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_tag_baru"
                android:backgroundTint="#FDF7E2"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="14 hari lagi"
                android:textColor="#F57F17"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvNamaProgram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nama Program"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_dialog_map"
                app:tint="#D32F2F" />
            <TextView
                android:id="@+id/tvWilayah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Wilayah"
                android:textColor="#555555"
                android:textSize="12sp" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <TextView
                android:id="@+id/tvTerkumpul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0 terkumpul"
                android:textColor="#888888"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/tvPersentaseTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0%"
                android:textColor="@color/primary_purple"
                android:textStyle="bold"
                android:textSize="12sp" />
        </RelativeLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:trackColor="#F3E5F5"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp"
            app:indicatorColor="@color/primary_purple"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvTargetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target: Rp 0"
                android:textColor="#AAAAAA"
                android:textSize="10sp" />
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
            <TextView
                android:id="@+id/tvKurangLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kurang Rp 0"
                android:textColor="#AAAAAA"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="#F8F7FF" android:paddingVertical="10dp" android:paddingHorizontal="4dp">
                <TextView android:id="@+id/tvDonaturCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/primary_purple" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Donatur" android:textColor="#888888" android:textSize="10sp" />
            </LinearLayout>

            <View android:layout_width="8dp" android:layout_height="1dp" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="#F8F7FF" android:paddingVertical="10dp" android:paddingHorizontal="4dp">
                <TextView android:id="@+id/tvPenerimaCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/primary_purple" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Penerima" android:textColor="#888888" android:textSize="10sp" />
            </LinearLayout>

            <View android:layout_width="8dp" android:layout_height="1dp" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="#F8F7FF" android:paddingVertical="10dp" android:paddingHorizontal="4dp">
                <TextView android:id="@+id/tvHariLagiStat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/primary_purple" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hari Lagi" android:textColor="#888888" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLihatDetail"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="Lihat Detail"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_purple"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditProgram"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="12dp"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="#888888"
                app:strokeColor="#DDDDDD"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>